{
  // Activity Loader — Cloudflare Worker + static assets + D1.
  // Production deploys from `main`; staging is the `staging` environment.
  "name": "activity-loader",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/invite/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "activity-loader-db",
      "database_id": "45eb3ffd-0701-4764-b322-4dfdd90d9612",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_AI_MODEL": "gemini-2.5-flash",
    "AI_MONTHLY_LIMIT": "50",
    "ADMIN_EMAILS": "nathanksimpson@gmail.com"
  },
  "env": {
    "staging": {
      "name": "activity-loader-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "activity-loader-staging-db",
          "database_id": "981fdb8a-338d-48d6-9aca-466127213dac",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SITE_AI_MODEL": "gemini-2.5-flash",
        "AI_MONTHLY_LIMIT": "50",
        "ADMIN_EMAILS": "nathanksimpson@gmail.com"
      }
    }
  }
  // Secrets (set in the dashboard or with `wrangler secret put`, per environment):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GEMINI_API_KEY
}
